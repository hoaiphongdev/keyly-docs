---
import { marked } from 'marked';

const CHANGELOG_URL = 'https://raw.githubusercontent.com/hoaiphongdev/keyly/main/CHANGELOG.md';

let html = '';
let error = '';

try {
  const response = await fetch(CHANGELOG_URL);
  if (!response.ok) {
    throw new Error(`Failed to fetch: ${response.status}`);
  }
  
  const markdown = await response.text();
  
  // Remove the "# Changelog" title and description (first 4 lines)
  const lines = markdown.split('\n');
  const contentWithoutHeader = lines.slice(4).join('\n');
  
  // Convert internal links to docs links
  const processedMarkdown = contentWithoutHeader
    .replace(/`scripts\/install-templates\.sh`/g, '[template installer script](/configuration/templates/)')
    .replace(/`cursor\.keyly`/g, '`cursor.keyly`');
  
  html = await marked.parse(processedMarkdown);
} catch (e) {
  error = e instanceof Error ? e.message : 'Failed to load changelog';
}
---

{error ? (
  <div class="error-box">
    <p>⚠️ Could not load changelog from GitHub: {error}</p>
    <p>
      <a href="https://github.com/hoaiphongdev/keyly/blob/main/CHANGELOG.md" target="_blank" rel="noopener">
        View changelog on GitHub →
      </a>
    </p>
  </div>
) : (
  <div class="remote-changelog" set:html={html} />
)}

<style>
  .error-box {
    padding: 1rem;
    background: var(--sl-color-orange-low);
    border: 1px solid var(--sl-color-orange);
    border-radius: 0.5rem;
    margin: 1rem 0;
  }
  
  .remote-changelog :global(h2) {
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--sl-color-gray-5);
  }
  
  .remote-changelog :global(h2:first-child) {
    margin-top: 0;
    padding-top: 0;
    border-top: none;
  }
  
  .remote-changelog :global(h3) {
    margin-top: 1.5rem;
    color: var(--sl-color-white);
  }
  
  .remote-changelog :global(ul) {
    margin: 0.5rem 0;
  }
  
  .remote-changelog :global(li) {
    margin: 0.25rem 0;
  }
</style>

