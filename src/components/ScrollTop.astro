---
// "Back to top" button on every page: appears after scrolling past ~1.2 screens; its ring
// fills with reading progress.
const label = Astro.locals.starlightRoute.locale === 'vi' ? 'Lên đầu trang' : 'Back to top';
---

<button type="button" class="kc-top" aria-label={label} title={label} hidden>
	<svg class="ring" viewBox="0 0 44 44" aria-hidden="true">
		<rect class="track" x="1" y="1" width="42" height="42" pathLength="100"></rect>
		<rect class="fill" x="1" y="1" width="42" height="42" pathLength="100"></rect>
	</svg>
	<svg class="arrow" viewBox="0 0 16 16" aria-hidden="true">
		<path d="M8 13V3M3.5 7.5 8 3l4.5 4.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square"></path>
	</svg>
</button>

<script>
	const button = document.querySelector<HTMLButtonElement>('.kc-top');
	if (button) {
		const fill = button.querySelector<SVGRectElement>('.fill')!;
		let frame = 0;
		const update = () => {
			frame = 0;
			const max = document.documentElement.scrollHeight - innerHeight;
			const progress = max > 0 ? Math.min(1, scrollY / max) : 0;
			const show = scrollY > innerHeight * 1.2;
			if (show) button.hidden = false;
			button.classList.toggle('on', show);
			fill.style.strokeDashoffset = String(100 - progress * 100);
		};
		addEventListener('scroll', () => (frame ||= requestAnimationFrame(update)), { passive: true });
		addEventListener('resize', update);
		update();
		button.addEventListener('click', () => {
			const smooth = !matchMedia('(prefers-reduced-motion: reduce)').matches;
			scrollTo({ top: 0, behavior: smooth ? 'smooth' : 'auto' });
			document.querySelector<HTMLElement>('#_top')?.focus({ preventScroll: true });
		});
	}
</script>

<style>
	.kc-top {
		position: fixed;
		right: max(1rem, env(safe-area-inset-right));
		bottom: max(1rem, env(safe-area-inset-bottom));
		z-index: 20;
		display: grid;
		place-items: center;
		width: 2.75rem;
		height: 2.75rem;
		padding: 0;
		border: 0;
		background: color-mix(in srgb, var(--kc-bg) 82%, transparent);
		-webkit-backdrop-filter: blur(10px);
		backdrop-filter: blur(10px);
		color: var(--kc-ink);
		cursor: pointer;
		opacity: 0;
		transform: translateY(8px);
		pointer-events: none;
		transition:
			opacity 200ms ease,
			transform 250ms var(--kc-ease),
			color 150ms ease;
	}
	.kc-top.on {
		opacity: 1;
		transform: none;
		pointer-events: auto;
	}
	.kc-top:hover {
		color: var(--sl-color-text-accent);
	}
	.kc-top > svg {
		grid-area: 1 / 1;
	}
	.ring {
		width: 100%;
		height: 100%;
		overflow: visible;
	}
	.ring rect {
		fill: none;
		stroke-width: 1;
	}
	.track {
		stroke: var(--kc-line-strong);
	}
	.fill {
		stroke: var(--sl-color-accent);
		stroke-dasharray: 100;
		stroke-dashoffset: 100;
		stroke-width: 2;
		transition: stroke-dashoffset 120ms linear;
	}
	.arrow {
		width: 1rem;
		height: 1rem;
		transition: transform 200ms var(--kc-ease);
	}
	.kc-top:hover .arrow {
		transform: translateY(-2px);
	}
	@media (prefers-reduced-motion: reduce) {
		.kc-top,
		.fill,
		.arrow {
			transition: none;
		}
	}
</style>
