---
import { copy, INSTALL_METHODS, type Lang } from './copy';

interface Props {
	lang: Lang;
}

const t = copy[Astro.props.lang].install;
---

<div class="kh-install not-content" data-reveal>
	<div class="kh-meta">
		<span class="kc-label kh-caption">{t.caption}</span>
	</div>

	<div class="term">
		<div class="bar">
			<span class="lights" aria-hidden="true"><i></i><i></i><i></i></span>
			<div class="tabs" role="group" aria-label={t.methods}>
				{
					INSTALL_METHODS.map((m, i) => (
						<button type="button" class="tab kc-label" data-tab={m.id} aria-pressed={i === 0 ? 'true' : 'false'}>
							{m.label}
						</button>
					))
				}
			</div>
			<button type="button" class="copy kc-label" data-copied={t.copied}>{t.copy}</button>
		</div>
		<div class="screen">
			{
				INSTALL_METHODS.map((m, i) => (
					<div class="pane" data-for={m.id} hidden={i > 0}>
						<p class="line"><span class="prompt">~ %</span> <code class="cmd">{m.command}</code><span class="cursor" aria-hidden="true" /></p>
						{t.output[m.id].map((line, n) => (
							<p class:list={['out', { ok: n === 1 }]} aria-hidden="true">
								{line}
							</p>
						))}
					</div>
				))
			}
		</div>
	</div>

	<ol class="steps">
		<li>
			<span class="num kc-label">01</span>
			<span>{t.intro} {INSTALL_METHODS.map((m, i) => <code data-for={m.id} hidden={i > 0}>{m.short}</code>)}</span>
		</li>
		<li>
			<span class="num kc-label">02</span>
			<span>{t.after}</span>
		</li>
		<li>
			<span class="num kc-label">03</span>
			<span><strong>{t.done}</strong> <kbd>⇪</kbd><kbd>⇪</kbd></span>
		</li>
	</ol>
</div>

<script>
	// Tabs switch between Homebrew and curl. Each command types once, the first time its tab is shown
	// with the terminal in view; Copy puts the exact command of the shown tab on the clipboard.
	document.querySelectorAll<HTMLElement>('.kh-install').forEach((root) => {
		const tabs = [...root.querySelectorAll<HTMLButtonElement>('.tab')];
		const panes = [...root.querySelectorAll<HTMLElement>('.pane')];
		const button = root.querySelector<HTMLButtonElement>('.copy')!;
		const label = button.textContent;
		const commands = new Map(panes.map((pane) => [pane, pane.querySelector<HTMLElement>('.cmd')!.textContent ?? '']));
		const typed = new Set<HTMLElement>();
		const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
		let inView = false;

		const shown = () => panes.find((pane) => !pane.hidden)!;

		const type = (pane: HTMLElement) => {
			if (reduceMotion || !inView || typed.has(pane)) return;
			typed.add(pane);
			const cmd = pane.querySelector<HTMLElement>('.cmd')!;
			const outs = [...pane.querySelectorAll<HTMLElement>('.out')];
			const full = commands.get(pane)!;
			let i = 0;
			const step = () => {
				cmd.textContent = full.slice(0, ++i);
				if (i < full.length) setTimeout(step, 14 + Math.random() * 22);
				else outs.forEach((out, n) => setTimeout(() => out.classList.add('show'), 450 + n * 550));
			};
			setTimeout(step, 400);
		};

		tabs.forEach((tab) =>
			tab.addEventListener('click', () => {
				tabs.forEach((other) => other.setAttribute('aria-pressed', String(other === tab)));
				root.querySelectorAll<HTMLElement>('[data-for]').forEach((el) => (el.hidden = el.dataset.for !== tab.dataset.tab));
				type(shown());
			})
		);

		button.addEventListener('click', async () => {
			try {
				await navigator.clipboard.writeText(commands.get(shown())!);
				button.textContent = button.dataset.copied ?? label;
				button.classList.add('done');
				setTimeout(() => {
					button.textContent = label;
					button.classList.remove('done');
				}, 1600);
			} catch {}
		});

		if (reduceMotion) {
			root.classList.add('typed');
			return;
		}

		root.classList.add('ready');
		panes.forEach((pane) => (pane.querySelector<HTMLElement>('.cmd')!.textContent = ''));
		const observer = new IntersectionObserver(
			([entry]) => {
				if (!entry?.isIntersecting) return;
				observer.disconnect();
				inView = true;
				type(shown());
			},
			{ threshold: 0.4 }
		);
		observer.observe(root);
	});
</script>

<style>
	.term {
		max-width: 56rem;
		margin: 2rem auto 0;
		border: 1px solid var(--kc-line-strong);
		border-radius: 12px;
		overflow: hidden;
		background: #0b0b0d;
		box-shadow:
			0 30px 70px -30px rgb(0 0 0 / 0.7),
			0 0 60px -20px var(--kc-glow);
	}
	.bar {
		display: flex;
		align-items: center;
		gap: 1rem;
		height: 2.5rem;
		padding: 0 0.875rem;
		border-bottom: 1px solid rgb(255 255 255 / 0.08);
		background: #16171a;
	}
	.lights {
		display: flex;
		gap: 0.4rem;
	}
	.lights i {
		width: 0.7rem;
		height: 0.7rem;
		border-radius: 50%;
		background: #ff5f57;
	}
	.lights i:nth-child(2) {
		background: #febc2e;
	}
	.lights i:nth-child(3) {
		background: #28c840;
	}
	.tabs {
		display: flex;
		gap: 0.25rem;
		margin: 0 auto;
	}
	.tab,
	.copy {
		padding: 0.3rem 0.7rem;
		white-space: nowrap;
		border: 1px solid rgb(255 255 255 / 0.18);
		background: none;
		color: rgb(242 241 238 / 0.8);
		cursor: pointer;
		transition:
			border-color 150ms ease,
			color 150ms ease;
	}
	.tab {
		border-color: transparent;
		color: rgb(242 241 238 / 0.5);
	}
	.tab:hover {
		color: rgb(242 241 238 / 0.8);
	}
	.tab[aria-pressed='true'] {
		border-color: rgb(255 255 255 / 0.18);
		color: #fff;
	}
	.copy:hover,
	.copy.done {
		border-color: var(--sl-color-accent);
		color: #fff;
	}
	.screen {
		min-height: 9.5rem;
		padding: 1.25rem 1.25rem 1.5rem;
		font-family: var(--sl-font-mono);
		font-size: clamp(0.75rem, 0.7rem + 0.25vw, 0.9375rem);
		line-height: 1.8;
		color: #f2f1ee;
		overflow-x: auto;
	}
	.screen p {
		margin: 0;
	}
	.line {
		white-space: pre-wrap;
		word-break: break-all;
	}
	.prompt {
		color: hsl(328, 90%, 74%);
	}
	.cmd {
		padding: 0;
		border: 0;
		background: none;
		font: inherit;
		color: inherit;
	}
	.cursor {
		display: inline-block;
		width: 0.55em;
		height: 1.1em;
		margin-left: 2px;
		vertical-align: text-bottom;
		background: hsl(328, 92%, 64%);
		animation: kh-blink 1s steps(1) infinite;
	}
	.out {
		color: rgb(242 241 238 / 0.55);
	}
	.out.ok {
		color: #6ee7a8;
	}
	/* Fake output only appears once JS has typed the command */
	.ready .out {
		opacity: 0;
		transform: translateY(4px);
		transition:
			opacity 300ms ease,
			transform 300ms ease;
	}
	.ready .out.show {
		opacity: 1;
		transform: none;
	}
	.kh-install:not(.ready):not(.typed) .out {
		display: none;
	}

	.steps {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1px;
		max-width: 56rem;
		margin: 1.5rem auto 0;
		padding: 0;
		list-style: none;
		border: 1px solid var(--kc-line);
		background: var(--kc-line);
	}
	.steps li {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		margin: 0;
		padding: 1rem 1.25rem;
		background: var(--kc-bg);
		color: var(--kc-muted);
		font-size: 0.9375rem;
	}
	.num {
		color: var(--sl-color-text-accent);
	}
	.steps code {
		white-space: nowrap;
		padding: 0.05em 0.35em;
		border: 1px solid var(--kc-line);
		background: var(--kc-sunken);
		font-size: 0.85em;
	}
	.steps strong {
		color: var(--kc-ink-strong);
	}
	.steps kbd {
		display: inline-grid;
		place-items: center;
		min-width: 1.4rem;
		height: 1.4rem;
		margin-left: 0.2rem;
		border: 1px solid var(--sl-color-accent);
		color: var(--sl-color-text-accent);
		font: 0.8rem var(--sl-font-mono);
	}

	@media (max-width: 50rem) {
		.steps {
			grid-template-columns: 1fr;
		}
	}

	@keyframes kh-blink {
		50% {
			opacity: 0;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.cursor {
			animation: none;
		}
	}
</style>
