---
import { copy, type Lang } from './copy';

interface Props {
	lang: Lang;
}

const t = copy[Astro.props.lang].footer;
---

<section class="kh-band not-content">
	<div class="words" aria-hidden="true">
		<div class="words-track">
			{
				[0, 1].map(() => (
					<span class="word">
						KEYLY <i>⇪⇪</i> KEYLY <i>⇪⇪</i>
					</span>
				))
			}
		</div>
	</div>

	<div class="cta">
		<a class="sl-link-button primary" href={t.startHref}>{t.start} →</a>
		<button type="button" class="sl-link-button secondary" onclick="dispatchEvent(new Event('keyly:demo'))">
			⇪ ⇪ {t.tryIt}
		</button>
	</div>

</section>

<style>
	.kh-band {
		margin: clamp(3.5rem, 7vw, 5rem) calc(-1 * clamp(1rem, 4vw, 2.5rem)) 0;
		border-top: 1px solid var(--kc-line);
		overflow: hidden;
	}
	.words {
		padding-block: clamp(1rem, 3vw, 2rem);
		border-bottom: 1px solid var(--kc-line);
		mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
	}
	.words-track {
		display: flex;
		width: max-content;
		animation: kh-words 30s linear infinite;
	}
	.word {
		padding-right: 0.3em;
		font-family: var(--kc-font-display);
		font-size: clamp(5rem, 16vw, 15rem);
		font-weight: 800;
		letter-spacing: -0.05em;
		line-height: 0.9;
		white-space: nowrap;
		color: transparent;
		-webkit-text-stroke: 1px var(--kc-line-strong);
	}
	.word i {
		font-style: normal;
		font-weight: 400;
		font-size: 0.45em;
		vertical-align: 0.6em;
		color: var(--sl-color-accent);
		-webkit-text-stroke: 0;
	}

	.cta {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.75rem;
		margin-top: 2rem;
	}
	.cta button {
		cursor: pointer;
	}


	@keyframes kh-words {
		to {
			transform: translateX(-50%);
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.words-track {
			animation: none;
		}
	}
</style>
