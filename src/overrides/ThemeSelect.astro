---
import { Icon } from '@astrojs/starlight/components';

const t = Astro.locals.t;
const label = t('themeSelect.accessibleLabel');
// The button names the theme it switches to, e.g. "Select theme: Light"
const toLight = `${label}: ${t('themeSelect.light')}`;
const toDark = `${label}: ${t('themeSelect.dark')}`;
---

<kc-theme-toggle data-to-light={toLight} data-to-dark={toDark}>
	<button type="button" aria-label={label} title={label}>
		<Icon name="sun" class="sun" size="1rem" />
		<Icon name="moon" class="moon" size="1rem" />
	</button>
</kc-theme-toggle>

<script>
	// Same storage key and data-theme attribute as overrides/ThemeProvider.astro, whose
	// inline script applies the saved choice on load (dark when nothing is saved).
	type Theme = 'dark' | 'light';

	const storageKey = 'starlight-theme';
	const root = document.documentElement;
	const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');

	const syncLabels = () => {
		const next = root.dataset.theme === 'light' ? 'dark' : 'light';
		document.querySelectorAll<HTMLElement>('kc-theme-toggle').forEach((toggle) => {
			const text = next === 'light' ? toggle.dataset.toLight : toggle.dataset.toDark;
			const button = toggle.querySelector('button');
			if (text && button) {
				button.setAttribute('aria-label', text);
				button.title = text;
			}
		});
	};

	const applyTheme = (theme: Theme) => {
		if (!reduceMotion.matches) {
			root.classList.add('kc-theme-anim');
			setTimeout(() => root.classList.remove('kc-theme-anim'), 320);
		}
		root.dataset.theme = theme;
		syncLabels();
	};

	class KcThemeToggle extends HTMLElement {
		constructor() {
			super();
			syncLabels();
			this.querySelector('button')?.addEventListener('click', () => {
				const next: Theme = root.dataset.theme === 'light' ? 'dark' : 'light';
				applyTheme(next);
				try {
					localStorage.setItem(storageKey, next);
				} catch {}
			});
		}
	}
	customElements.define('kc-theme-toggle', KcThemeToggle);
</script>

<style>
	kc-theme-toggle {
		display: flex;
	}
	button {
		display: grid;
		place-items: center;
		width: 2rem;
		height: 2rem;
		padding: 0;
		border: 1px solid var(--kc-line);
		background: transparent;
		color: var(--kc-muted);
		cursor: pointer;
		transition:
			border-color 150ms ease,
			color 150ms ease,
			background-color 150ms ease;
	}
	button:hover {
		border-color: var(--kc-line-strong);
		background: var(--kc-raised);
		color: var(--kc-ink);
	}
	button > :global(svg) {
		grid-area: 1 / 1;
		transition:
			opacity 200ms ease,
			transform 300ms var(--kc-ease);
	}
	/* Show the icon for the theme you would switch to */
	:global(:root[data-theme='dark']) .moon,
	:global(:root[data-theme='light']) .sun {
		opacity: 0;
		transform: rotate(-90deg) scale(0.6);
	}
</style>
