---
import Default from '@astrojs/starlight/components/Footer.astro';
import KeylyDemo from '../components/KeylyDemo.astro';
import ScrollTop from '../components/ScrollTop.astro';
import DocsMotion from '../components/DocsMotion.astro';

const isVi = Astro.locals.starlightRoute.locale === 'vi';
---

<Default {...Astro.props} />
<div class="kc-credit">
	<span>{isVi ? 'Được làm với' : 'Made with'} <span class="heart" aria-label={isVi ? 'tình yêu' : 'love'}>❤️</span> {isVi ? 'bởi' : 'by'} <a href="https://github.com/hoaiphongdev">hoaiphongdev</a></span>
	<a class="repo" href="https://github.com/hoaiphongdev/keyly">github.com/hoaiphongdev/keyly ↗</a>
</div>
<KeylyDemo />
<ScrollTop />
<DocsMotion />

<style>
	.kc-credit {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 0.5rem 1.5rem;
		margin-top: 2rem;
		padding-top: 1rem;
		border-top: 1px solid var(--kc-line);
		font-family: var(--sl-font-mono);
		font-size: 0.6875rem;
		letter-spacing: 0.08em;
		color: var(--kc-faint);
	}
	a {
		color: var(--kc-muted);
		text-decoration: none;
		transition: color 150ms ease;
	}
	a:hover {
		color: var(--sl-color-text-accent);
	}
	.heart {
		font-size: 0.875em;
	}
</style>
