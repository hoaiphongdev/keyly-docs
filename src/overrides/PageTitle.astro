---
// Page header for docs pages: a mono breadcrumb from the sidebar, the title, the frontmatter
// description as a lead, and a reading-time line. No new copy; everything comes from the entry.
const route = Astro.locals.starlightRoute;
const { title, description } = route.entry.data;
const isVi = route.locale === 'vi';

type Entry = (typeof route.sidebar)[number];
const findCurrent = (entries: Entry[]): Entry | undefined => {
	for (const entry of entries) {
		if (entry.type === 'link' && entry.isCurrent) return entry;
		if (entry.type === 'group') {
			const found = findCurrent(entry.entries);
			if (found) return found;
		}
	}
};
const groupIndex = route.sidebar.findIndex((entry) => entry.type === 'group' && findCurrent(entry.entries));
const group = route.sidebar[groupIndex];
const current = findCurrent(route.sidebar);
// Autogenerated sidebar labels repeat the title, so only add the page label when it is shorter
const crumb = group
	? [`${String(groupIndex + 1).padStart(2, '0')} / ${group.label}`, current && current.label !== title ? current.label : undefined]
			.filter(Boolean)
			.join(' — ')
	: undefined;

// Count prose only: drop JSON-LD/script blocks, MDX imports and component tags
const prose = (route.entry.body ?? '')
	.replace(/<script[\s\S]*?<\/script>/g, ' ')
	.replace(/^import .*$/gm, ' ')
	.replace(/<[^>]+>/g, ' ');
const words = prose.split(/\s+/).filter(Boolean).length;
const minutes = Math.max(1, Math.round(words / 200));
const sections = route.headings.filter((h) => h.depth === 2).length;
const meta = isVi
	? [`~${minutes} phút đọc`, sections ? `${sections} mục` : undefined]
	: [`~${minutes} min read`, sections ? `${sections} section${sections === 1 ? '' : 's'}` : undefined];
---

<header class="kc-pagehead">
	{crumb && <p class="crumb kc-label">{crumb}</p>}
	<h1 id="_top" tabindex="-1">{title}</h1>
	{description && <p class="lead">{description}</p>}
	<p class="meta kc-label">
		{
			meta.filter(Boolean).map((item, i) => (
				<>
					{i > 0 && <span class="dot" aria-hidden="true" />}
					<span>{item}</span>
				</>
			))
		}
	</p>
</header>

<style>
	.kc-pagehead {
		display: flex;
		flex-direction: column;
		gap: 0.875rem;
		margin-top: 1rem;
		animation: kc-head-in 500ms var(--kc-ease) both;
	}
	.crumb {
		margin: 0;
		color: var(--kc-muted);
	}
	h1 {
		margin: 0;
		text-wrap: balance;
	}
	.lead {
		max-width: 42rem;
		margin: 0;
		font-size: clamp(1.0625rem, 1rem + 0.3vw, 1.1875rem);
		line-height: 1.6;
		color: var(--sl-color-gray-2);
		text-wrap: pretty;
	}
	.meta {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		margin: 0.25rem 0 0;
		color: var(--kc-faint);
	}
	.dot {
		width: 3px;
		height: 3px;
		background: var(--sl-color-accent);
	}
	@keyframes kc-head-in {
		from {
			opacity: 0;
			transform: translateY(6px);
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.kc-pagehead {
			animation: none;
		}
	}
</style>
