---
import Default from '@astrojs/starlight/components/Head.astro';
// Same files fonts.css pulls in, so these preloads hit the hashed URLs the CSS uses
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import archivoLatin from '@fontsource-variable/archivo/files/archivo-latin-wght-normal.woff2?url';

// Route ids carry no extension: '' and 'vi' are the homepages, the rest match /og/<id>.png
const routeId = Astro.locals.starlightRoute.id;
const isHomepage = routeId === '' || routeId === 'vi';

const ogImageUrl = new URL(isHomepage ? '/og-home.png' : `/og/${routeId}.png`, Astro.site);

const currentLocale = Astro.locals.starlightRoute.locale || 'en';
const currentPath = Astro.url.pathname;

function getDefaultUrl(): string {
	let path = currentPath;
	// English is the root locale, so the default version lives at the unprefixed path
	if (currentLocale === 'vi') {
		path = path.replace(/^\/vi/, '') || '/';
	}
	if (!path.endsWith('/')) path += '/';
	return new URL(path, Astro.site).href;
}

const viSegmentNames: Record<string, string> = {
	configuration: 'Cấu hình',
	resources: 'Tài liệu thêm',
};

function formatBreadcrumbName(segment: string): string {
	if (currentLocale === 'vi' && viSegmentNames[segment]) return viSegmentNames[segment];
	return segment
		.split('-')
		.map(word => word.charAt(0).toUpperCase() + word.slice(1))
		.join(' ');
}

function generateBreadcrumbs() {
	const baseUrl = Astro.site?.href || 'https://keyly-docs.com';
	let path = currentPath;
	
	if (currentLocale === 'vi') {
		path = path.replace(/^\/vi/, '');
	}
	
	const segments = path.replace(/\/$/, '').split('/').filter(Boolean);
	
	const items: Array<{ name: string; url: string }> = [];
	
	const homeUrl = currentLocale === 'vi' ? `${baseUrl}vi/` : baseUrl;
	items.push({ name: currentLocale === 'vi' ? 'Trang chủ' : 'Home', url: homeUrl });
	
	let currentUrl = currentLocale === 'vi' ? '/vi' : '';
	
	for (let i = 0; i < segments.length; i++) {
		const segment = segments[i];
		currentUrl += `/${segment}`;
		const fullUrl = new URL(currentUrl + '/', Astro.site).href;
		
		const name = i === segments.length - 1 && Astro.locals.starlightRoute?.entry?.data?.title
			? Astro.locals.starlightRoute.entry.data.title.split(' - ')[0].split(' | ')[0]
			: formatBreadcrumbName(segment);
		
		items.push({ name, url: fullUrl });
	}
	
	return items;
}

const breadcrumbs = generateBreadcrumbs();

const breadcrumbSchema = {
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	"itemListElement": breadcrumbs.map((item, index) => ({
		"@type": "ListItem",
		"position": index + 1,
		"name": item.name,
		"item": item.url
	}))
};

const pageTitle = Astro.locals.starlightRoute?.entry?.data?.title || 'Keyly Docs';
const pageDescription = Astro.locals.starlightRoute?.entry?.data?.description || '';

const webPageSchema = {
	"@context": "https://schema.org",
	"@type": "WebPage",
	"name": pageTitle,
	"description": pageDescription,
	"url": Astro.url.href,
	"publisher": {
		"@type": "Person",
		"name": "Nguyễn Hoài Phong",
		"url": "https://github.com/hoaiphongdev"
	}
};

const webSiteSchema = {
	"@context": "https://schema.org",
	"@type": "WebSite",
	"name": "Keyly",
	"alternateName": "Keyly Docs",
	"inLanguage": currentLocale === 'vi' ? 'vi' : 'en',
	"url": Astro.site?.href || "https://keyly-docs.com",
	"description": currentLocale === 'vi'
		? "App xem phím tắt miễn phí, mã nguồn mở cho macOS. Nhấn đúp ⇪ Caps Lock để xem mọi phím tắt của bất kỳ ứng dụng nào."
		: "Free, open-source keyboard shortcut viewer for macOS. Double-tap ⇪ Caps Lock to reveal every shortcut in any app.",
	"publisher": {
		"@type": "Person",
		"name": "Nguyễn Hoài Phong",
		"url": "https://github.com/hoaiphongdev"
	},
	"sameAs": ["https://github.com/hoaiphongdev/keyly"]
};

// Tells search engines and AI answers what Keyly is: a free macOS app, not just a docs site
const softwareAppSchema = {
	"@context": "https://schema.org",
	"@type": "SoftwareApplication",
	"name": "Keyly",
	"applicationCategory": "UtilitiesApplication",
	"applicationSubCategory": "Keyboard shortcut viewer",
	"operatingSystem": "macOS 12+",
	"description": webSiteSchema.description,
	"url": Astro.site?.href || "https://keyly-docs.com",
	"downloadUrl": "https://github.com/hoaiphongdev/keyly",
	"installUrl": new URL('/getting-started/', Astro.site).href,
	"image": new URL('/og-home.png', Astro.site).href,
	"isAccessibleForFree": true,
	"license": "https://opensource.org/licenses/MIT",
	"offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
	"author": webSiteSchema.publisher,
	"sameAs": ["https://github.com/hoaiphongdev/keyly"]
};
---
<Default><slot /></Default>
{/* Body and heading fonts are on every page's first paint; fetch them alongside the HTML */}
{
	[interLatin, archivoLatin].map((href) => (
		<link rel="preload" href={href} as="font" type="font/woff2" crossorigin />
	))
}
{/* Untranslated /vi/ pages repeat the English content; keep them out of search results */}
<meta name="robots" content={Astro.locals.starlightRoute.isFallback ? 'noindex, follow' : 'index, follow'} />
<meta name="google-site-verification" content="gs5sb1_HqWtAz-TWENvrZ9dlJpMbZS908fyEfHu8PEA" />
<meta name="msvalidate.01" content="D726E89FAAAB73C449CDB7B11564F6BE" />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:image" content={ogImageUrl} />
<link rel="alternate" hreflang="x-default" href={getDefaultUrl()} />
<script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
<script is:inline type="application/ld+json" set:html={JSON.stringify(webPageSchema)} />
{isHomepage && <script is:inline type="application/ld+json" set:html={JSON.stringify(webSiteSchema)} />}
{isHomepage && <script is:inline type="application/ld+json" set:html={JSON.stringify(softwareAppSchema)} />}
