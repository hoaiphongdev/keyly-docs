---
import Default from '@astrojs/starlight/components/Head.astro';

const ogImageUrl = new URL(
	`${import.meta.env.BASE_URL}/og/${Astro.locals.starlightRoute.id.replace(/\.\w+$/, '.png')}`,
	Astro.site
);

const currentLocale = Astro.locals.starlightRoute.locale || 'en';
const currentPath = Astro.url.pathname;

function getDefaultUrl(): string {
	let path = currentPath;
	if (currentLocale === 'vi') {
		path = path.replace(/^\/vi/, '/en');
	}
	if (!path.endsWith('/')) path += '/';
	return new URL(path, Astro.site).href;
}
---
<Default><slot /></Default>
<meta property="og:image" content={ogImageUrl} />
<meta name="twitter:image" content={ogImageUrl} />
<link rel="alternate" hreflang="x-default" href={getDefaultUrl()} />
