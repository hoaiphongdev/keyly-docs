---
import config from 'virtual:starlight/user-config';

const currentLocale = Astro.locals.starlightRoute.locale || 'root';
const currentPath = Astro.url.pathname;

function getLocalizedPath(targetLocale: string): string {
	let path = currentPath;
	
	if (currentLocale === 'vi') {
		path = path.replace(/^\/vi/, '') || '/';
	}
	if (targetLocale === 'root') {
		path = path || '/';
	} else {
		path = `/${targetLocale}${path === '/' ? '' : path}`;
	}
	
	if (!path.endsWith('/')) path += '/';
	return path;
}

const localeCodes: Record<string, string> = {
	root: 'EN',
	en: 'EN',
	vi: 'VI',
};

const locales = Object.entries(config.locales || {}).map(([code, locale]) => ({
	label: locale!.label,
	code: localeCodes[code] || code.toUpperCase(),
	href: getLocalizedPath(code),
	isActive: code === currentLocale,
}));

const currentLang = locales.find(l => l.isActive) || locales[0];
---

{config.isMultilingual && (
	<div class="lang-select">
		<button class="lang-trigger" aria-expanded="false" aria-haspopup="listbox" aria-label={`${Astro.locals.t('languageSelect.accessibleLabel')}: ${currentLang.label}`} title={currentLang.label}>
			<span class="code">{currentLang.code}</span>
			<svg class="caret" width="12" height="12" viewBox="0 0 12 12" fill="none">
				<path d="M3 4.5L6 7.5L9 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
			</svg>
		</button>
		<ul class="lang-dropdown" role="listbox">
			{locales.map(locale => (
				<li role="option" aria-selected={locale.isActive}>
					<a href={locale.href} class:list={['lang-option', { active: locale.isActive }]}>
						<span class="code">{locale.code}</span>
						<span class="label">{locale.label}</span>
					</a>
				</li>
			))}
		</ul>
	</div>
)}

<style>
	.lang-select {
		position: relative;
		display: flex;
		align-items: center;
	}

	.lang-trigger {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		height: 2rem;
		padding: 0 0.625rem;
		background: transparent;
		border: 1px solid var(--kc-line);
		border-radius: 0;
		color: var(--kc-muted);
		cursor: pointer;
		font-family: var(--sl-font-mono);
		font-size: 0.6875rem;
		font-weight: 500;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		line-height: 1;
		transition:
			border-color 150ms ease,
			color 150ms ease,
			background-color 150ms ease;
	}

	.lang-trigger:hover,
	.lang-select[data-open] .lang-trigger {
		border-color: var(--kc-line-strong);
		background: var(--kc-raised);
		color: var(--kc-ink);
	}

	.code {
		color: var(--sl-color-text-accent);
	}

	.lang-trigger .caret {
		transition: transform 200ms ease;
	}

	.lang-select[data-open] .lang-trigger .caret {
		transform: rotate(180deg);
	}

	.lang-dropdown {
		position: absolute;
		top: calc(100% + 0.375rem);
		right: 0;
		min-width: 100%;
		padding: 0;
		margin: 0;
		list-style: none;
		background: var(--kc-bg);
		border: 1px solid var(--kc-line-strong);
		box-shadow: var(--sl-shadow-lg);
		opacity: 0;
		visibility: hidden;
		transform: translateY(-0.25rem);
		transition:
			opacity 150ms ease,
			transform 150ms ease,
			visibility 150ms;
		z-index: 100;
	}

	.lang-select[data-open] .lang-dropdown {
		opacity: 1;
		visibility: visible;
		transform: translateY(0);
	}

	.lang-dropdown li + li {
		border-top: 1px solid var(--kc-line);
	}

	.lang-option {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		padding: 0.625rem 0.875rem;
		color: var(--kc-muted);
		text-decoration: none;
		font-size: 0.875rem;
		white-space: nowrap;
		transition:
			background-color 120ms ease,
			color 120ms ease;
	}

	.lang-option .code {
		font-family: var(--sl-font-mono);
		font-size: 0.6875rem;
		font-weight: 500;
		letter-spacing: 0.12em;
		color: var(--kc-faint);
	}

	.lang-option:hover {
		background: var(--kc-raised);
		color: var(--kc-ink);
	}

	.lang-option.active {
		background: var(--kc-ink);
		color: var(--kc-bg);
		font-weight: 500;
	}

	.lang-option.active .code {
		color: inherit;
	}
</style>

<script>
	document.querySelectorAll('.lang-select').forEach(select => {
		const trigger = select.querySelector('.lang-trigger');
		
		trigger?.addEventListener('click', (e) => {
			e.stopPropagation();
			const isOpen = select.hasAttribute('data-open');
			document.querySelectorAll('.lang-select[data-open]').forEach(s => s.removeAttribute('data-open'));
			if (!isOpen) {
				select.setAttribute('data-open', '');
				trigger.setAttribute('aria-expanded', 'true');
			} else {
				trigger.setAttribute('aria-expanded', 'false');
			}
		});
	});

	document.addEventListener('click', () => {
		document.querySelectorAll('.lang-select[data-open]').forEach(s => {
			s.removeAttribute('data-open');
			s.querySelector('.lang-trigger')?.setAttribute('aria-expanded', 'false');
		});
	});

	document.addEventListener('keydown', (e) => {
		if (e.key === 'Escape') {
			document.querySelectorAll('.lang-select[data-open]').forEach(s => {
				s.removeAttribute('data-open');
				s.querySelector('.lang-trigger')?.setAttribute('aria-expanded', 'false');
			});
		}
	});
</script>
