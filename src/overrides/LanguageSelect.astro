---
import config from 'virtual:starlight/user-config';

const currentLocale = Astro.locals.starlightRoute.locale || 'root';
const currentPath = Astro.url.pathname;

function getLocalizedPath(targetLocale: string): string {
	let path = currentPath;
	
	if (currentLocale === 'vi') {
		path = path.replace(/^\/vi/, '') || '/';
	}
	if (targetLocale === 'root') {
		path = path || '/';
	} else {
		path = `/${targetLocale}${path === '/' ? '' : path}`;
	}
	
	if (!path.endsWith('/')) path += '/';
	return path;
}

const localeFlags: Record<string, string> = {
	root: '🇺🇸',
	en: '🇺🇸',
	vi: '🇻🇳',
};

const locales = Object.entries(config.locales || {}).map(([code, locale]) => ({
	code,
	label: locale!.label,
	flag: localeFlags[code] || '🌐',
	href: getLocalizedPath(code),
	isActive: code === currentLocale,
}));

const currentLang = locales.find(l => l.isActive) || locales[0];
---

{config.isMultilingual && (
	<div class="lang-select">
		<button class="lang-trigger" aria-expanded="false" aria-haspopup="listbox">
			<span class="flag">{currentLang.flag}</span>
			<span class="label">{currentLang.label}</span>
			<svg class="caret" width="12" height="12" viewBox="0 0 12 12" fill="none">
				<path d="M3 4.5L6 7.5L9 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
			</svg>
		</button>
		<ul class="lang-dropdown" role="listbox">
			{locales.map(locale => (
				<li role="option" aria-selected={locale.isActive}>
					<a href={locale.href} class:list={['lang-option', { active: locale.isActive }]}>
						<span class="flag">{locale.flag}</span>
						<span class="label">{locale.label}</span>
					</a>
				</li>
			))}
		</ul>
	</div>
)}

<style>
	.lang-select {
		position: relative;
		display: flex;
		align-items: center;
	}

	.lang-trigger {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.375rem 0.625rem;
		background: transparent;
		border: 1px solid color-mix(in srgb, var(--sl-color-accent) 30%, transparent);
		border-radius: 0.5rem;
		color: var(--sl-color-white);
		cursor: pointer;
		font-size: 0.875rem;
		line-height: 1;
		transition: all 0.15s ease;
	}

	.lang-trigger:hover {
		border-color: color-mix(in srgb, var(--sl-color-accent) 60%, transparent);
		background: color-mix(in srgb, var(--sl-color-accent) 10%, transparent);
	}

	.lang-trigger .flag {
		font-size: 1rem;
	}

	.lang-trigger .caret {
		transition: transform 0.2s ease;
	}

	.lang-select[data-open] .lang-trigger {
		border-color: var(--sl-color-accent);
	}

	.lang-select[data-open] .lang-trigger .caret {
		transform: rotate(180deg);
	}

	.lang-dropdown {
		position: absolute;
		top: calc(100% + 0.5rem);
		right: 0;
		min-width: 100%;
		padding: 0.5rem;
		margin: 0;
		list-style: none;
		background: color-mix(in srgb, var(--sl-color-bg) 95%, var(--sl-color-accent));
		border: 1px solid color-mix(in srgb, var(--sl-color-accent) 40%, transparent);
		border-radius: 0.5rem;
		box-shadow: 0 4px 16px color-mix(in srgb, var(--sl-color-accent) 20%, rgba(0, 0, 0, 0.3));
		opacity: 0;
		visibility: hidden;
		transform: translateY(-0.5rem);
		transition: all 0.15s ease;
		z-index: 100;
	}

	.lang-select[data-open] .lang-dropdown {
		opacity: 1;
		visibility: visible;
		transform: translateY(0);
	}

	.lang-option {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.5rem 0.75rem;
		border-radius: 0.375rem;
		color: var(--sl-color-gray-2);
		text-decoration: none;
		font-size: 0.875rem;
		white-space: nowrap;
		transition: all 0.1s ease;
	}

	.lang-option:hover {
		background: color-mix(in srgb, var(--sl-color-accent) 15%, transparent);
		color: var(--sl-color-white);
	}

	.lang-option.active {
		color: var(--sl-color-accent);
		font-weight: 500;
	}

	.lang-option.active:hover {
		color: var(--sl-color-accent);
	}

	.lang-option .flag {
		font-size: 1rem;
	}
</style>

<script>
	document.querySelectorAll('.lang-select').forEach(select => {
		const trigger = select.querySelector('.lang-trigger');
		
		trigger?.addEventListener('click', (e) => {
			e.stopPropagation();
			const isOpen = select.hasAttribute('data-open');
			document.querySelectorAll('.lang-select[data-open]').forEach(s => s.removeAttribute('data-open'));
			if (!isOpen) {
				select.setAttribute('data-open', '');
				trigger.setAttribute('aria-expanded', 'true');
			} else {
				trigger.setAttribute('aria-expanded', 'false');
			}
		});
	});

	document.addEventListener('click', () => {
		document.querySelectorAll('.lang-select[data-open]').forEach(s => {
			s.removeAttribute('data-open');
			s.querySelector('.lang-trigger')?.setAttribute('aria-expanded', 'false');
		});
	});

	document.addEventListener('keydown', (e) => {
		if (e.key === 'Escape') {
			document.querySelectorAll('.lang-select[data-open]').forEach(s => {
				s.removeAttribute('data-open');
				s.querySelector('.lang-trigger')?.setAttribute('aria-expanded', 'false');
			});
		}
	});
</script>
